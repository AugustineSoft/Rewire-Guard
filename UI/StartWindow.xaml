<ui:ThemedWindow x:Class="RewireGuard.UI.StartWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:RewireGuard.UI"
                 Width="500"
                 SizeToContent="Height"
                 WindowStartupLocation="CenterScreen">
    <ui:ThemedWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RewireGuard;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ThemedWindow.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent" Height="44">
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                        HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </Grid>

            <!-- ================= WELCOME PANE ================= -->
            <StackPanel x:Name="WelcomePane" Grid.Row="1" Margin="36,4,36,32">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <Border Width="40" Height="40" CornerRadius="11"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1">
                        <Ellipse Width="12" Height="12" Fill="{StaticResource AccentLevel1Brush}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Rewire Guard"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontFamily="{StaticResource TextFont}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="{StaticResource TextFont}"
                           FontSize="13.5" LineHeight="21" TextWrapping="Wrap"
                           Margin="0,0,0,24"
                           Text="Watches your screen locally and steps in when it needs to. Images never leave this machine — only the optional Pavlok signal touches the network."/>

                <!-- Readiness checklist -->
                <Border Background="{StaticResource SurfaceRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1"
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,26">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ModelDot" Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{StaticResource AccentCalmBrush}"/>
                                <TextBlock Text="Detection model" Margin="10,0,0,0"
                                           Style="{StaticResource RowLabel}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="ModelStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontFamily="{StaticResource TextFont}" FontSize="12"/>
                        </Grid>

                        <!-- Shown only when the model is missing: it is too large to ship in the
                             repository, so onboarding fetches it rather than leaving a fresh
                             clone unable to run. -->
                        <StackPanel x:Name="ModelDownloadPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <Button x:Name="DownloadModelButton"
                                    Style="{StaticResource GhostButton}"
                                    Content="Download model (330 MB)"
                                    Height="36"
                                    HorizontalAlignment="Stretch"/>

                            <Grid x:Name="DownloadProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="DownloadTrack" Grid.Column="0" Height="5" CornerRadius="3"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SurfaceSunkenBrush}">
                                    <Border x:Name="DownloadFill" HorizontalAlignment="Left" Width="0"
                                            CornerRadius="3" Background="{StaticResource AccentCalmBrush}"/>
                                </Border>
                                <TextBlock x:Name="DownloadStatus" Grid.Column="1" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="11.5"/>
                            </Grid>

                            <TextBlock x:Name="DownloadError"
                                       Foreground="{StaticResource AccentLevel3Brush}"
                                       FontFamily="{StaticResource TextFont}" FontSize="11.5"
                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PavlokDot" Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{StaticResource TextTertiaryBrush}"/>
                                <TextBlock Text="Pavlok device" Margin="10,0,0,0"
                                           Style="{StaticResource RowLabel}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock x:Name="PavlokStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}"
                                       FontFamily="{StaticResource TextFont}" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button x:Name="ConnectButton"
                        Style="{StaticResource PrimaryButton}"
                        Tag="{StaticResource AccentLevel1Brush}"
                        Content="Connect Pavlok"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,10"/>

                <Grid>
                    <Button x:Name="SettingsButton" Style="{StaticResource QuietButton}"
                            Content="Settings" MinWidth="100" Height="38" HorizontalAlignment="Left"/>
                    <Button x:Name="SkipButton" Style="{StaticResource QuietButton}"
                            Content="Continue without it" MinWidth="150" Height="38" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- ================= CONNECT PANE ================= -->
            <StackPanel x:Name="ConnectPane" Grid.Row="1" Margin="36,4,36,32" Visibility="Collapsed">
                <TextBlock Text="Connect your Pavlok"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="20" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="{StaticResource TextFont}" FontSize="13" LineHeight="20"
                           TextWrapping="Wrap" Margin="0,0,0,22"
                           Text="An API key from the Pavlok dashboard is the sturdier option — it does not expire the way a login session does."/>

                <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="ApiKeyMode" Grid.Column="0" GroupName="Mode" Content="API key"
                                     Style="{StaticResource SegmentButton}" IsChecked="True"
                                     HorizontalContentAlignment="Center"/>
                        <RadioButton x:Name="PasswordMode" Grid.Column="1" GroupName="Mode" Content="Email and password"
                                     Style="{StaticResource SegmentButton}"
                                     HorizontalContentAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="ApiKeyFields">
                    <TextBlock Text="API KEY" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ApiKeyBox" Style="{StaticResource ThemedTextBox}"/>
                    <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0"
                               Text="Stored encrypted with your Windows account, never in the config file."/>
                </StackPanel>

                <StackPanel x:Name="PasswordFields" Visibility="Collapsed">
                    <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="EmailBox" Style="{StaticResource ThemedTextBox}" Margin="0,0,0,14"/>
                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource ThemedPasswordBox}"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource AccentLevel3Brush}"
                           FontFamily="{StaticResource TextFont}" FontSize="12.5"
                           TextWrapping="Wrap" Margin="0,14,0,0"
                           Visibility="Collapsed"/>

                <Grid Margin="0,24,0,0">
                    <Button x:Name="BackButton" Style="{StaticResource QuietButton}"
                            Content="Back" MinWidth="90" Height="42" HorizontalAlignment="Left"/>
                    <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}"
                            Tag="{StaticResource AccentCalmBrush}" Foreground="#0E1410"
                            Content="Connect" MinWidth="140" Height="42" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</ui:ThemedWindow>
