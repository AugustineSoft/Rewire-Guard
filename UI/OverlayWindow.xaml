<Window x:Class="RewireGuard.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RewireGuard;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Covers the whole virtual desktop; bounds are set in code so every monitor is included. -->
    <Grid>
        <!-- Flat dim, opacity raised with the level in SetLevel. -->
        <Rectangle x:Name="Backdrop" Fill="#000000" Opacity="0.55"/>

        <!-- Accent wash behind the card so the level reads even in peripheral vision. -->
        <Rectangle x:Name="AccentWash" Opacity="0.10">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="WashBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                     RadiusX="0.45" RadiusY="0.55">
                    <GradientStop x:Name="WashStop" Color="#E8A33D" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border x:Name="Card"
                Width="600"
                CornerRadius="16"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="40,32,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: wordmark left, escalation segments right -->
                <Grid Grid.Row="0" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{StaticResource AccentLevel1Brush}"/>
                        <TextBlock Text="REWIRE GUARD"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontFamily="{StaticResource TextFont}"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LevelText"
                                   Text="LEVEL 1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   FontFamily="{StaticResource TextFont}"
                                   FontSize="11"
                                   FontWeight="Bold"/>
                        <Border x:Name="Seg1" Width="22" Height="4" CornerRadius="2" Margin="2,0"
                                Background="{StaticResource AccentLevel1Brush}"/>
                        <Border x:Name="Seg2" Width="22" Height="4" CornerRadius="2" Margin="2,0"
                                Background="#2A2A31"/>
                        <Border x:Name="Seg3" Width="22" Height="4" CornerRadius="2" Margin="2,0"
                                Background="#2A2A31"/>
                    </StackPanel>
                </Grid>

                <!-- Headline -->
                <TextBlock x:Name="MessageText"
                           Grid.Row="1"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           LineHeight="36"
                           TextWrapping="Wrap"
                           Text="It's not worth it."/>

                <!-- Supporting line -->
                <TextBlock x:Name="SubText"
                           Grid.Row="2"
                           Margin="0,14,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="{StaticResource TextFont}"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap"
                           Text="Close the tab and this clears on its own."/>

                <!-- Sit-with-it countdown; collapsed unless a sit is running. -->
                <Grid x:Name="SitPanel" Grid.Row="3" Margin="0,24,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SitTrack" Grid.Column="0" Height="6" CornerRadius="3" VerticalAlignment="Center"
                            Background="{StaticResource SurfaceSunkenBrush}">
                        <Border x:Name="SitFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                CornerRadius="3"
                                Background="{StaticResource AccentCalmBrush}"/>
                    </Border>

                    <TextBlock x:Name="SitCountdown"
                               Grid.Column="1"
                               Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontFamily="{StaticResource TextFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="60s"/>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,32,0,0">
                    <Button x:Name="OverrideButton"
                            Style="{StaticResource QuietButton}"
                            Content="Override"
                            MinWidth="110"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"/>
                    <Button x:Name="CloseTabButton"
                            Style="{StaticResource PrimaryButton}"
                            Tag="{StaticResource AccentLevel1Brush}"
                            Content="Close active tab"
                            MinWidth="170"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
