<ui:ThemedWindow x:Class="RewireGuard.UI.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:RewireGuard.UI"
                 Width="620" Height="700"
                 WindowStartupLocation="CenterScreen">
    <ui:ThemedWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RewireGuard;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18,14"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </ui:ThemedWindow.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="HeaderBar" Grid.Row="0" Background="Transparent" Height="46">
                <TextBlock Text="SETTINGS" Style="{StaticResource WindowTitle}" Margin="22,0,0,0"/>
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarButton}"
                        HorizontalAlignment="Right" Margin="0,0,10,0"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,16,0">
                <StackPanel Margin="0,4,6,16">

                    <!-- ============ MONITORING ============ -->
                    <TextBlock Text="MONITORING" Style="{StaticResource SectionHeader}" Margin="0,6,0,12"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Poll interval" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="PollHint" Style="{StaticResource RowHint}"
                                               Text="How often the screen is checked."/>
                                </StackPanel>
                                <TextBlock x:Name="PollValue" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="PollSlider" Style="{StaticResource ThemedSlider}"
                                    Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Detection threshold" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Higher means fewer false positives but more misses."/>
                                </StackPanel>
                                <TextBlock x:Name="ThresholdValue" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="ThresholdSlider" Style="{StaticResource ThemedSlider}"
                                    Minimum="0.05" Maximum="0.99" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Scan all monitors" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Off watches only the primary display."/>
                                </StackPanel>
                                <CheckBox x:Name="AllMonitorsToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Tiled scanning" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Catches small thumbnails a whole-screen pass washes out. Costs CPU."/>
                                </StackPanel>
                                <CheckBox x:Name="TilingToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Skip unchanged regions" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Reuses results for parts of the screen that did not move. Much cheaper."/>
                                </StackPanel>
                                <CheckBox x:Name="ChangeDetectionToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AcceleratorCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Accelerator" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="AcceleratorHint" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="AccelAuto" Grid.Column="0" GroupName="Accel" Content="Auto"
                                                 Style="{StaticResource SegmentButton}" HorizontalContentAlignment="Center"/>
                                    <RadioButton x:Name="AccelNpu" Grid.Column="1" GroupName="Accel" Content="Intel NPU"
                                                 Style="{StaticResource SegmentButton}" HorizontalContentAlignment="Center"/>
                                    <RadioButton x:Name="AccelGpu" Grid.Column="2" GroupName="Accel" Content="GPU"
                                                 Style="{StaticResource SegmentButton}" HorizontalContentAlignment="Center"/>
                                    <RadioButton x:Name="AccelCpu" Grid.Column="3" GroupName="Accel" Content="CPU"
                                                 Style="{StaticResource SegmentButton}" HorizontalContentAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="AcceleratorNote" Style="{StaticResource RowHint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ============ ESCALATION ============ -->
                    <TextBlock Text="ESCALATION" Style="{StaticResource SectionHeader}" Margin="0,14,0,12"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Polls before escalating a level" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="RampHint" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <TextBlock x:Name="HitsValue" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="HitsSlider" Style="{StaticResource ThemedSlider}"
                                    Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Clear after clean minutes" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="How long the screen must stay clean before the overlay clears."/>
                                </StackPanel>
                                <TextBlock x:Name="CleanValue" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="CleanSlider" Style="{StaticResource ThemedSlider}"
                                    Minimum="0" Maximum="15" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Sit-with-it pause" Style="{StaticResource RowLabel}"/>
                                <TextBlock Style="{StaticResource RowHint}"
                                           Text="Seconds you wait after closing the tab, at level 2 and level 3."/>
                            </StackPanel>
                            <TextBox x:Name="Sit2Box" Grid.Column="1" Style="{StaticResource ThemedTextBox}"
                                     Width="64" Margin="0,0,8,0" VerticalAlignment="Center"
                                     TextAlignment="Center"/>
                            <TextBox x:Name="Sit3Box" Grid.Column="2" Style="{StaticResource ThemedTextBox}"
                                     Width="64" VerticalAlignment="Center" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- ============ PAVLOK ============ -->
                    <TextBlock Text="PAVLOK" Style="{StaticResource SectionHeader}" Margin="0,14,0,12"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Send stimuli" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="PavlokStatusHint" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox x:Name="PavlokToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PavlokDetail" Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Minimum seconds between stimuli" Style="{StaticResource RowLabel}"/>
                                    <TextBlock x:Name="CadenceHint" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <TextBlock x:Name="CadenceValue" HorizontalAlignment="Right" VerticalAlignment="Top"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Slider x:Name="CadenceSlider" Style="{StaticResource ThemedSlider}"
                                    Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,18"/>

                            <!-- Per-level stimulus -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Level 1" Style="{StaticResource RowLabel}"
                                           FontSize="12.5" Foreground="{StaticResource AccentLevel1Brush}"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="L1Vibe" GroupName="L1" Content="Vibe" Style="{StaticResource SegmentButton}"/>
                                        <RadioButton x:Name="L1Beep" GroupName="L1" Content="Beep" Style="{StaticResource SegmentButton}"/>
                                        <RadioButton x:Name="L1Zap"  GroupName="L1" Content="Zap"  Style="{StaticResource SegmentButton}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="L1ValueText" Grid.Column="2" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="12,0,10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="12"/>
                                <Slider x:Name="L1Slider" Grid.Column="3" Style="{StaticResource ThemedSlider}"
                                        Width="120" Minimum="1" Maximum="100" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Level 2" Style="{StaticResource RowLabel}"
                                           FontSize="12.5" Foreground="{StaticResource AccentLevel2Brush}"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="L2Vibe" GroupName="L2" Content="Vibe" Style="{StaticResource SegmentButton}"/>
                                        <RadioButton x:Name="L2Beep" GroupName="L2" Content="Beep" Style="{StaticResource SegmentButton}"/>
                                        <RadioButton x:Name="L2Zap"  GroupName="L2" Content="Zap"  Style="{StaticResource SegmentButton}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="L2ValueText" Grid.Column="2" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="12,0,10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="12"/>
                                <Slider x:Name="L2Slider" Grid.Column="3" Style="{StaticResource ThemedSlider}"
                                        Width="120" Minimum="1" Maximum="100" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Level 3" Style="{StaticResource RowLabel}"
                                           FontSize="12.5" Foreground="{StaticResource AccentLevel3Brush}"/>
                                <Border Grid.Column="1" Style="{StaticResource SegmentGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="L3Vibe" GroupName="L3" Content="Vibe" Style="{StaticResource SegmentButton}"/>
                                        <RadioButton x:Name="L3Beep" GroupName="L3" Content="Beep" Style="{StaticResource SegmentButton}"/>
                                        <RadioButton x:Name="L3Zap"  GroupName="L3" Content="Zap"  Style="{StaticResource SegmentButton}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="L3ValueText" Grid.Column="2" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="12,0,10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource TextFont}" FontSize="12"/>
                                <Slider x:Name="L3Slider" Grid.Column="3" Style="{StaticResource ThemedSlider}"
                                        Width="120" Minimum="1" Maximum="100" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ============ APP ============ -->
                    <TextBlock Text="APPLICATION" Style="{StaticResource SectionHeader}" Margin="0,14,0,12"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Launches to the tray when you sign in."/>
                                </StackPanel>
                                <CheckBox x:Name="AutostartToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid>
                                <StackPanel Margin="0,0,60,0">
                                    <TextBlock Text="Hold overlay in front" Style="{StaticResource RowLabel}"/>
                                    <TextBlock Style="{StaticResource RowHint}"
                                               Text="Pulls the overlay back if it loses focus, and blocks Alt+Tab. Harder to ignore, harder to escape."/>
                                </StackPanel>
                                <CheckBox x:Name="FocusLockToggle" Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel Margin="0,0,120,0">
                                <TextBlock Text="Diagnostics" Style="{StaticResource RowLabel}"/>
                                <TextBlock x:Name="DiagnosticsHint" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                            <Button x:Name="OpenLogsButton" Style="{StaticResource GhostButton}"
                                    Content="Open logs" Height="34" MinWidth="110"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <Grid>
                    <TextBlock x:Name="SaveStatus" VerticalAlignment="Center"
                               Foreground="{StaticResource TextTertiaryBrush}"
                               FontFamily="{StaticResource TextFont}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Style="{StaticResource QuietButton}"
                                Content="Cancel" Height="38" MinWidth="100" Margin="0,0,10,0"/>
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}"
                                Tag="{StaticResource AccentCalmBrush}" Foreground="#0E1410"
                                Content="Save changes" Height="38" MinWidth="140"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:ThemedWindow>
