<ui:ThemedWindow x:Class="RewireGuard.UI.ConfirmDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="clr-namespace:RewireGuard.UI"
                 SizeToContent="Height"
                 Width="440"
                 Topmost="True"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterScreen">
    <ui:ThemedWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RewireGuard;component/UI/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:ThemedWindow.Resources>

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="6" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                <Border x:Name="Badge" Width="26" Height="26" CornerRadius="13"
                        Background="#2A1D1C" VerticalAlignment="Center">
                    <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentLevel3Brush}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="Bold"/>
                </Border>
                <TextBlock x:Name="TitleText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="Confirm override"/>
            </StackPanel>

            <TextBlock x:Name="BodyText"
                       Grid.Row="1"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="{StaticResource TextFont}"
                       FontSize="13.5"
                       LineHeight="20"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton"
                        Style="{StaticResource QuietButton}"
                        Content="Cancel"
                        MinWidth="100"
                        Height="38"
                        Margin="0,0,10,0"/>
                <!-- White on red, not the style's default dark ink: dark text on this red is
                     muddy, and a destructive action is the last place to lose legibility. -->
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource PrimaryButton}"
                        Tag="{StaticResource AccentLevel3Brush}"
                        Foreground="#FFFFFF"
                        Content="Continue"
                        MinWidth="120"
                        Height="38"/>
            </StackPanel>
        </Grid>
    </Border>
</ui:ThemedWindow>
