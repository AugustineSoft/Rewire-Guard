{
  "PollIntervalSeconds": 3,

  "ModelPath": "Models/model.onnx",
  "InputSize": 384,
  "NsfwLabelIndex": 1,

  "DetectionThreshold": 0.60,
  "TilingEnabled": true,
  "TileDetectionThreshold": 0.75,
  "TileSize": 500,
  "TileOverlapFraction": 0.3,
  "ContentRegionWidthFraction": 0.6,

  "MaxTilesPerPoll": 12,
  "ChangeDetectionEnabled": true,
  "ChangeDetectionThreshold": 1.5,
  "CaptureAllMonitors": true,

  "ConsecutiveHitsToEscalate": 2,
  "CleanMinutesToReset": 2,

  "PavlokEnabled": true,
  "PavlokMinSecondsBetweenStimuli": 3,
  "PavlokLevel1Type": "vibe",
  "PavlokLevel1Value": 100,
  "PavlokLevel2Type": "zap",
  "PavlokLevel2Value": 30,
  "PavlokLevel3Type": "zap",
  "PavlokLevel3Value": 70,

  "SitSecondsLevel2": 20,
  "SitSecondsLevel3": 60,
  "OverlayFocusLock": false,

  "BrowserProcessNames": [
    "chrome", "msedge", "firefox", "brave", "opera", "opera_gx",
    "vivaldi", "arc", "librewolf", "waterfox", "zen", "iexplore"
  ]
}
