# Copy to .env and fill in. Never commit the real .env -- it is gitignored.
#
# Preferred: an API key issued from the Pavlok dashboard. Does not expire the way a
# login session does. You can also paste this into the app's start screen instead.
PAVLOK_API_KEY=

# Alternative: account credentials. Only used when PAVLOK_API_KEY is empty.
# PAVLOK_EMAIL=
# PAVLOK_PASSWORD=
