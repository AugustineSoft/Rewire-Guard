<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>RewireGuard-Setup</OutputName>
    <OutputType>Bundle</OutputType>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Burn's stock bootstrapper UI: one page, a licence link, progress, and a finish page. -->
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Supplies $(var.RewireGuardMsi.TargetPath) to Bundle.wxs and builds the MSI first. -->
    <ProjectReference Include="..\msi\RewireGuardMsi.wixproj" />
  </ItemGroup>

</Project>
