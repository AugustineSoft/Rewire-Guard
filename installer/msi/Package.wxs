<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    Per-user install. A tray app has no business asking for administrator rights: it writes its
    autostart entry to HKCU, keeps its token and logs under %LOCALAPPDATA%, and never touches a
    machine-wide resource. Installing per-user into %LOCALAPPDATA%\Programs means no UAC prompt
    at install time and none at uninstall either.
  -->
  <Package Name="Rewire Guard"
           Manufacturer="Rewire Guard"
           Version="$(ProductVersion)"
           UpgradeCode="D1F7CF78-0D02-4E36-B604-99EF0FC46D95"
           Scope="perUser"
           Compressed="yes">

    <SummaryInformation Description="Rewire Guard - local screen monitor with escalating intervention" />

    <!-- Replaces an older version in place rather than leaving two entries in Apps and Features. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Rewire Guard is already installed. Uninstall it first if you want to go back to this one." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(HarvestPath)\RewireGuard.exe" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Rewire Guard" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />

    <!--
      The install folder lives under the user profile and its subdirectory tree is harvested, so
      MSI has no static RemoveFolder entry for each generated directory. Left alone, uninstall
      deletes every file but leaves a skeleton of empty folders behind (and ICE64 fails the
      build over exactly this). RemoveFolderEx reads the path back from the registry at uninstall
      time and removes the tree recursively.
    -->
    <SetProperty Id="REWIREGUARD_INSTALLFOLDER" Value="[INSTALLFOLDER]" Before="CostFinalize" Sequence="both" />

    <Feature Id="Main" Title="Rewire Guard" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="Shortcuts" />
      <ComponentRef Id="CleanupInstallFolder" />
    </Feature>
  </Package>

  <Fragment>
    <Component Id="CleanupInstallFolder" Directory="INSTALLFOLDER" Guid="B6E2C7A4-51D8-4A93-8E77-2C4F0A9D3B15">
      <!-- The keypath registry value is also what RemoveFolderEx reads the path from. -->
      <RegistryValue Root="HKCU"
                     Key="Software\RewireGuard"
                     Name="InstallFolder"
                     Type="string"
                     Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
      <util:RemoveFolderEx On="uninstall" Property="REWIREGUARD_INSTALLFOLDER" />
    </Component>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <!--
        Harvests the staged payload wholesale. Listing ~500 files by hand would go stale the
        first time a NuGet dependency changes its native payload.

        WiX's Files element has no Exclude attribute, so everything that must not be packaged
        (appsettings.json, and Models\ for a slim build) is removed from the staging folder by
        installer\build.ps1 before this runs.
      -->
      <Files Include="$(HarvestPath)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="Shortcuts">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="9191F93C-65A6-4E85-B18D-042862378768">
        <Shortcut Id="AppShortcut"
                  Name="Rewire Guard"
                  Description="Local screen monitor with escalating intervention"
                  Target="[INSTALLFOLDER]RewireGuard.exe"
                  WorkingDirectory="INSTALLFOLDER" />

        <!-- A per-user component needs an HKCU keypath; a file under ProgramMenuFolder cannot be one. -->
        <RegistryValue Root="HKCU"
                       Key="Software\RewireGuard"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!--
    Note: appsettings.json is deliberately NOT packaged. The app writes a default one on first
    run if it is missing, which means an upgrade physically cannot overwrite settings the user
    changed in the Settings window. That guarantee is fiddly to get right with MSI component
    rules, and free if the installer simply never owns the file.
  -->

</Wix>
